{
  "name": "pi-robot-hand",
  "version": "0.1.1",
  "description": "Pi extension: the agent hands the user a command, and after the user agrees it lands in the pi prompt or the clipboard, never run by the agent",
  "type": "module",
  "license": "MIT",
  "author": "wayne930242",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wayne930242/pi-robot-hand.git"
  },
  "homepage": "https://github.com/wayne930242/pi-robot-hand#readme",
  "keywords": [
    "pi-package",
    "pi",
    "pi-coding-agent",
    "extension",
    "clipboard",
    "command",
    "approval"
  ],
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ],
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "scripts": {
    "check": "tsc --noEmit",
    "test": "node --test tests/*.test.ts"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "0.87.1",
    "@earendil-works/pi-coding-agent": "0.87.1",
    "@earendil-works/pi-tui": "0.87.1",
    "@types/node": "26.6.3",
    "typebox": "1.3.34",
    "typescript": "7.0.2"
  }
}
